{
  "$defs": {
    "Severity": {
      "enum": [
        "INFO",
        "LOW",
        "MEDIUM",
        "HIGH",
        "CRITICAL"
      ],
      "title": "Severity",
      "type": "string"
    },
    "VerificationStatus": {
      "enum": [
        "UNVERIFIED",
        "LIKELY",
        "CONFIRMED",
        "FALSE_POSITIVE"
      ],
      "title": "VerificationStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Canonical Finding contract for security vulnerabilities and misconfigurations.\n\nNOTE: Person 2 (Security Scanners & Tool Integrations Lead) must review\nthis contract before treating it as finalized for active scanner pipelines.",
  "properties": {
    "finding_id": {
      "title": "Finding Id",
      "type": "string"
    },
    "assessment_id": {
      "minLength": 3,
      "title": "Assessment Id",
      "type": "string"
    },
    "asset_id": {
      "minLength": 3,
      "title": "Asset Id",
      "type": "string"
    },
    "title": {
      "maxLength": 200,
      "minLength": 3,
      "title": "Title",
      "type": "string"
    },
    "description": {
      "minLength": 10,
      "title": "Description",
      "type": "string"
    },
    "cwe": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Common Weakness Enumeration, e.g. 'CWE-79'",
      "title": "Cwe"
    },
    "cve": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Common Vulnerabilities and Exposures, e.g. 'CVE-2023-1234'",
      "title": "Cve"
    },
    "severity": {
      "$ref": "#/$defs/Severity",
      "default": "MEDIUM"
    },
    "confidence": {
      "default": 0.8,
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Confidence",
      "type": "number"
    },
    "verification_status": {
      "$ref": "#/$defs/VerificationStatus",
      "default": "UNVERIFIED",
      "description": "Verification state; never defaults to CONFIRMED"
    },
    "evidence_ids": {
      "description": "Cryptographic references to supporting Evidence objects. Model-generated evidence IDs are strictly rejected unless verified against storage.",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Evidence Ids",
      "type": "array"
    },
    "root_cause": {
      "anyOf": [
        {
          "maxLength": 500,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Root Cause"
    },
    "remediation": {
      "description": "Actionable technical steps to resolve finding",
      "minLength": 5,
      "title": "Remediation",
      "type": "string"
    },
    "tool_name": {
      "minLength": 1,
      "title": "Tool Name",
      "type": "string"
    },
    "tool_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": "1.0",
      "title": "Tool Version"
    },
    "first_seen": {
      "format": "date-time",
      "title": "First Seen",
      "type": "string"
    },
    "last_seen": {
      "format": "date-time",
      "title": "Last Seen",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "assessment_id",
    "asset_id",
    "title",
    "description",
    "evidence_ids",
    "remediation",
    "tool_name"
  ],
  "title": "AegisPT Finding Contract v1",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}