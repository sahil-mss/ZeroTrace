{
  "$defs": {
    "JobAuditEntry": {
      "additionalProperties": false,
      "description": "Lifecycle transition history log entry.",
      "properties": {
        "from_status": {
          "anyOf": [
            {
              "$ref": "#/$defs/JobStatus"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "to_status": {
          "$ref": "#/$defs/JobStatus"
        },
        "timestamp": {
          "format": "date-time",
          "title": "Timestamp",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        }
      },
      "required": [
        "to_status"
      ],
      "title": "JobAuditEntry",
      "type": "object"
    },
    "JobStatus": {
      "enum": [
        "CREATED",
        "POLICY_CHECK",
        "QUEUED",
        "RUNNING",
        "REVIEW",
        "COMPLETED",
        "FAILED",
        "CANCELLED",
        "NEEDS_APPROVAL"
      ],
      "title": "JobStatus",
      "type": "string"
    },
    "ResourceBudget": {
      "additionalProperties": false,
      "description": "Execution bounds enforced on a worker/tool job.",
      "properties": {
        "timeout_seconds": {
          "default": 180,
          "description": "Hard timeout ceiling",
          "maximum": 1800,
          "minimum": 5,
          "title": "Timeout Seconds",
          "type": "integer"
        },
        "max_requests_per_minute": {
          "default": 60,
          "maximum": 1000,
          "minimum": 1,
          "title": "Max Requests Per Minute",
          "type": "integer"
        },
        "max_concurrency": {
          "default": 3,
          "maximum": 10,
          "minimum": 1,
          "title": "Max Concurrency",
          "type": "integer"
        }
      },
      "title": "ResourceBudget",
      "type": "object"
    },
    "TestPermissionLevel": {
      "enum": [
        "PASSIVE_ONLY",
        "ACTIVE_NON_INTRUSIVE",
        "CONTROLLED_VULN_SCAN",
        "INTRUSIVE_TEST"
      ],
      "title": "TestPermissionLevel",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Canonical Job record representing an isolated, bounded unit of work.",
  "properties": {
    "job_id": {
      "title": "Job Id",
      "type": "string"
    },
    "assessment_id": {
      "minLength": 3,
      "title": "Assessment Id",
      "type": "string"
    },
    "task_type": {
      "description": "Tool task key (e.g. 'OSINT_DNS', 'ZAP_SCAN')",
      "minLength": 2,
      "title": "Task Type",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/JobStatus",
      "default": "CREATED",
      "description": "Lifecycle status"
    },
    "requested_targets": {
      "description": "Explicit targets requested for execution",
      "items": {
        "type": "string"
      },
      "title": "Requested Targets",
      "type": "array"
    },
    "target_input": {
      "default": "",
      "description": "Primary canonical target string (backward-compatible)",
      "title": "Target Input",
      "type": "string"
    },
    "permission_level": {
      "$ref": "#/$defs/TestPermissionLevel",
      "default": "PASSIVE_ONLY"
    },
    "resource_budget": {
      "$ref": "#/$defs/ResourceBudget"
    },
    "timeout_seconds": {
      "default": 180,
      "description": "Backward-compatible timeout shortcut",
      "maximum": 1800,
      "minimum": 5,
      "title": "Timeout Seconds",
      "type": "integer"
    },
    "max_retries": {
      "default": 2,
      "maximum": 5,
      "minimum": 0,
      "title": "Max Retries",
      "type": "integer"
    },
    "attempt_count": {
      "default": 0,
      "maximum": 5,
      "minimum": 0,
      "title": "Attempt Count",
      "type": "integer"
    },
    "cancellation_requested": {
      "default": false,
      "title": "Cancellation Requested",
      "type": "boolean"
    },
    "cancellation_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cancellation Reason"
    },
    "error_message": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error Message"
    },
    "result_summary": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Result Summary"
    },
    "audit_history": {
      "items": {
        "$ref": "#/$defs/JobAuditEntry"
      },
      "title": "Audit History",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "started_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Started At"
    },
    "completed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Completed At"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "assessment_id",
    "task_type"
  ],
  "title": "AegisPT Job Contract v1",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}