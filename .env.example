# ==============================================================================
# ZeroTrace - Central Application Configuration Template
# NOTE: Never commit sensitive credentials or real secrets to version control.
# ==============================================================================

# Application Metadata & Runtime Environment
APP_NAME=ZeroTrace
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true

# Server Network Settings
HOST=127.0.0.1
PORT=8000

# Authentication (Development Prototype)
# When unset or empty, protected REST API endpoints fail closed.
# Set a secret token for testing (e.g. openssl rand -hex 32).
# Documented: One shared API token is a dev prototype, not a complete multi-user system.
API_BEARER_TOKEN=

# Persistence & Storage Directories
STORAGE_DIR=./aegis_data
EVIDENCE_STORAGE_PATH=./aegis_data/evidence_blobs
DATABASE_URL=sqlite:///./aegis_data/aegispt.db

# Scope, Rate Limiting & Safety Controls
DEFAULT_JOB_TIMEOUT_SECONDS=300
DEFAULT_MAX_CONCURRENCY=3
DEFAULT_MAX_REQUESTS_PER_MINUTE=60
ALLOW_INTRUSIVE_TESTS=false

